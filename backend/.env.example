# ====================================
# NexusCRM Backend Configuration
# ====================================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Database (AWS RDS / PostgreSQL)
# Supports: AWS RDS, Aurora, Neon, Supabase, any PostgreSQL
DB_HOST=your-rds-instance.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nexuscrm
DB_USER=nexuscrm_app
DB_PASSWORD=your-secure-password
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional: path to RDS CA bundle for SSL verification
DB_SSL_CA_PATH=./certs/rds-combined-ca-bundle.pem
# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=20

# AWS Cognito
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
COGNITO_CLIENT_ID=your-cognito-client-id
COGNITO_REGION=ap-south-1

# AWS Secrets Manager (optional - for loading secrets dynamically)
AWS_SECRETS_MANAGER_SECRET_ID=nexuscrm/production
AWS_REGION=ap-south-1

# AI Providers (configure one or more)
# AWS Bedrock
AI_BEDROCK_ENABLED=true
AI_BEDROCK_REGION=us-east-1
AI_BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# OpenAI
AI_OPENAI_ENABLED=true
AI_OPENAI_API_KEY=sk-your-openai-key
AI_OPENAI_DEFAULT_MODEL=gpt-4o

# Google Gemini
AI_GOOGLE_ENABLED=true
AI_GOOGLE_API_KEY=your-google-ai-key
AI_GOOGLE_DEFAULT_MODEL=gemini-2.5-flash

# Default AI provider: bedrock | openai | google
AI_DEFAULT_PROVIDER=bedrock

# S3 Storage (for file uploads)
S3_BUCKET=nexuscrm-uploads
S3_REGION=ap-south-1

# CORS
CORS_ORIGINS=http://localhost:8080,https://your-domain.com

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
